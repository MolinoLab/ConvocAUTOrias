# Imagen n8n con Python y dependencias del proyecto para Execute Command
# Permite que los workflows ejecuten scripts Python (worker_scraper, revisar_convocatorias, sync_caldav)
FROM n8nio/n8n:latest

USER root

# Instalar Python y pip
RUN apk add --no-cache python3 py3-pip

# Copiar e instalar dependencias Python del proyecto
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

USER node
